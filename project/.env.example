# The WaterBoard SpacetimeDB connection config.
# Copy this file to `.env.local` and adjust for your environment.
# Only NEXT_PUBLIC_* vars are read by the Next.js client.
#
# The host may be given as http(s):// or ws(s)://; the client normalizes it
# to a websocket URL automatically.

# ---- Local development (default: run `spacetime start` + publish `waterboard`) ----
NEXT_PUBLIC_SPACETIMEDB_HOST=ws://127.0.0.1:3000
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=waterboard

# ---- Shared Maincloud database (teammate's deployment) ----
# NOTE: the shared DB `hackutd-2026-t3uux` currently hosts a DIFFERENT schema.
# Only point here once The WaterBoard module is published to it.
# NEXT_PUBLIC_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com/
# NEXT_PUBLIC_SPACETIMEDB_DB_NAME=hackutd-2026-t3uux

# ---- Reference: other frameworks (not used by this Next.js app) ----
# Vite:            VITE_SPACETIMEDB_HOST / VITE_SPACETIMEDB_DB_NAME
# Create React App: REACT_APP_SPACETIMEDB_HOST / REACT_APP_SPACETIMEDB_DB_NAME
# Expo:            EXPO_PUBLIC_SPACETIMEDB_HOST / EXPO_PUBLIC_SPACETIMEDB_DB_NAME
# SvelteKit:       PUBLIC_SPACETIMEDB_HOST / PUBLIC_SPACETIMEDB_DB_NAME
